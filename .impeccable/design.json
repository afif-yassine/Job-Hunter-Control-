      "html": "<a class=\"ds-brand\" href=\"#accueil\" aria-label=\"LeBonTaf, accueil\"><svg class=\"ds-declic\" viewBox=\"0 0 64 64\" fill=\"none\" aria-hidden=\"true\"><path d=\"M8 10h14v25a7 7 0 0 0 7 7h25v14H29A21 21 0 0 1 8 35V10Z\" fill=\"currentColor\"/><path d=\"M29 8h27v27H42V22H29V8Z\" fill=\"currentColor\"/><path d=\"m28 35 12-12\" stroke=\"currentColor\" stroke-width=\"8\"/></svg><span>lebon<span class=\"ds-italic\">taf</span><span class=\"ds-dot\">.</span></span></a>",
      "css": ".ds-brand{display:inline-flex;align-items:center;gap:10px;white-space:nowrap;color:#2d241e;text-decoration:none;font-family:var(--font-sans,'Instrument Sans'),sans-serif;}.ds-brand>span{font-size:33px;font-weight:600;letter-spacing:-.04em;line-height:1}.ds-italic{font-family:var(--font-fell,'IM Fell English'),Georgia,serif;font-style:italic;font-weight:400;font-size:1.12em}.ds-dot{color:#695747}.ds-declic{width:42px;height:42px;color:#7b2d26;overflow:visible}.ds-brand:focus-visible{outline:3px solid #2d241e;outline-offset:5px}@media(hover:hover){.ds-brand:hover path:nth-child(1){transform:translate(-1px,1px);transition:transform 220ms ease-out}.ds-brand:hover path:nth-child(2){transform:translate(2px,-2px);transition:transform 220ms ease-out}}@media(prefers-reduced-motion:reduce){.ds-brand:hover path{transform:none;transition:none}}"
