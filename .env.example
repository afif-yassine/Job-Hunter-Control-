# --- Supabase (dashboard) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- AI (scoring, CV / lettres, révisions) — see lib/ai.ts -----------------
GEMINI_API_KEY=
# Optional: change model without touching code. Every score / document records its model.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-3.6-flash
# AI_MODEL_ANALYSIS=      # scoring (high volume, a cheap model is fine)
# AI_MODEL_WRITING=       # CV, letter, revisions (quality first)

# --- Daily limits per account (Paris day, 0 = unlimited) -------------------
# QUOTA_SCANS_PER_DAY=3          # searches started from the dashboard
# QUOTA_ANALYSES_PER_DAY=20
# QUOTA_GENERATIONS_PER_DAY=10

# --- Safety -----------------------------------------------------------------
# PREPARE_ONLY is the only supported mode (nothing is ever submitted).
# If the variable is missing the app behaves as PREPARE_ONLY.
APPLICATION_MODE=PREPARE_ONLY

# --- Playwright worker on Railway ------------------------------------------
WORKER_BASE_URL=
WORKER_SHARED_SECRET=

# --- Google Drive ----------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_CVS_FOLDER_ID=1A-3_h9B4qhYhq5corJ_7a2BkA5M3M-KC
GOOGLE_DRIVE_LETTERS_FOLDER_ID=1MWtIRuy-zZA2KUjwZGgl7FvKoClEywH6

# --- Offer scanner (see docs/SCANNER.md) -----------------------------------
# The keys below can also be typed in the dashboard (Réglages > Sources): they are then
# encrypted with INTEGRATIONS_SECRET (any long random phrase) and stored in Supabase.
INTEGRATIONS_SECRET=
# 0) "All internet" via Google Jobs (LinkedIn, Indeed, WTTJ...): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=
# 0b) Aggregators (optional): https://developer.adzuna.com  /  https://fr.jooble.org/api/about
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# 1) Official French job offers API (free): https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# 2) Job-alert e-mails read from Gmail (LinkedIn, Indeed, Hellowork, APEC, WTTJ)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ALERT_LABEL=job-alerts
# 3) Optional: search terms / départements / age, as JSON
# SCAN_CONFIG={"queries":[{"keywords":"alternance développeur"}],"departments":["75","92"],"maxAgeDays":14}
# 4) Optional external scanner returning {"offers":[...]} (kept for compatibility)
SCAN_WEBHOOK_URL=
SCAN_WEBHOOK_SECRET=
# 5) Scheduled server run for every account: search → score → documents
#    (/api/cron/tick, see docs/SCANNER.md §4). Server-only, never NEXT_PUBLIC_.
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# SCAN_INTERVAL_HOURS=12          # search each account at most this often
# AUTO_GENERATE_THRESHOLD=80      # write CV + letter from this score
