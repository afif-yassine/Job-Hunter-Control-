# --- Supabase (dashboard) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Gemini (scoring, CV / lettres, révisions) ----------------------------
GEMINI_API_KEY=

# --- Safety -----------------------------------------------------------------
# PREPARE_ONLY is the only supported mode (nothing is ever submitted).
# If the variable is missing the app behaves as PREPARE_ONLY.
APPLICATION_MODE=PREPARE_ONLY

# --- Playwright worker on Railway ------------------------------------------
WORKER_BASE_URL=
WORKER_SHARED_SECRET=

# --- Google Drive ----------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_CVS_FOLDER_ID=1A-3_h9B4qhYhq5corJ_7a2BkA5M3M-KC
GOOGLE_DRIVE_LETTERS_FOLDER_ID=1MWtIRuy-zZA2KUjwZGgl7FvKoClEywH6

# --- Offer scanner (see docs/SCANNER.md) -----------------------------------
# 1) Official French job offers API (free): https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# 2) Job-alert e-mails read from Gmail (LinkedIn, Indeed, Hellowork, APEC, WTTJ)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ALERT_LABEL=job-alerts
# 3) Optional: search terms / départements / age, as JSON
# SCAN_CONFIG={"queries":[{"keywords":"alternance développeur"}],"departments":["75","92"],"maxAgeDays":14}
# 4) Optional external scanner returning {"offers":[...]} (kept for compatibility)
SCAN_WEBHOOK_URL=
SCAN_WEBHOOK_SECRET=
# 5) Optional daily automatic scan (server-only, never NEXT_PUBLIC_)
CRON_SECRET=
SCAN_USER_ID=
SUPABASE_SERVICE_ROLE_KEY=
